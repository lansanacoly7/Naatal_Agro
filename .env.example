# ==============================================================================
# NAATAL AGRO — CONFIGURATION D'ENVIRONNEMENT GLOBALE
# ==============================================================================
# Pour configurer le backend Django, consultez backend/.env.example

DEBUG=True
USE_POSTGRES=False
DB_NAME=naatal_agro_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
SECRET_KEY=votre-cle-secrete-django-tres-longue-et-aleatoire-min-50-caracteres

# APIs tierces
API_KEY_OPENWEATHER=
API_KEY_GROQ=
API_KEY_GEMINI=
GEMINI_MODEL=gemini-2.5-flash

# Firebase
FIREBASE_CREDENTIALS_PATH=core/firebase_credentials.json

# Déploiement & CORS
ALLOWED_HOSTS=localhost,127.0.0.1,naatal_backend,nginx,naatal-agro.sn
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://naatal-agro.sn

