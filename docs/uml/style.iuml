skinparam titleFontSize 20
skinparam titleFontColor #1B5E20
skinparam legendBackgroundColor #F4F6F8
skinparam legendBorderColor #C8E6C9
skinparam ActorBorderColor #1B5E20
skinparam ActorBackgroundColor #E8F5E9
skinparam ActorFontStyle bold
skinparam PackageBorderColor #81C784
skinparam PackageBackgroundColor #F6FBF6
