skinparam UsecaseBackgroundColor #E8F5E9
skinparam UsecaseBorderColor #2E7D32
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #2E7D32
skinparam ClassHeaderBackgroundColor #E8F5E9
skinparam ClassAttributeIconSize 0
skinparam RectangleBorderColor #1B5E20
skinparam RectangleBackgroundColor #FFFFFF
skinparam NoteBackgroundColor #FFF4D6
skinparam NoteBorderColor #F2A900
skinparam SequenceLifeLineBorderColor #81C784
