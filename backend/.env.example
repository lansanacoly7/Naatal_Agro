# ==============================================================================
# NAATAL AGRO — FICHIER DE CONFIGURATION D'ENVIRONNEMENT (EXEMPLE)
# ==============================================================================
# Copiez ce fichier vers .env et renseignez vos véritables informations secrètes.
# NE COMMITEZ JAMAIS LE FICHIER .env CONTENANT DES CLÉS PRIVÉES.

# Sécurité Django
DEBUG=True
SECRET_KEY=votre-cle-secrete-django-tres-longue-et-aleatoire-min-50-caracteres

# Base de données (PostgreSQL)
# Pour utiliser PostgreSQL en local ou en production, passez USE_POSTGRES=True
USE_POSTGRES=False
DB_NAME=naatal_agro_db
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Clés d'APIs tierces
# Groq (LLM rapide pour conseil agronomique & analyse textuelle)
API_KEY_GROQ=gsk_votre_cle_api_groq_ici

# Google Gemini (Vision par ordinateur & diagnostic maladies des cultures)
API_KEY_GEMINI=AIzaSy_votre_cle_api_gemini_ici

# OpenWeatherMap (Prévisions météorologiques géolocalisées pour exploitants)
API_KEY_OPENWEATHER=votre_cle_api_openweather_ici

# Firebase Cloud Messaging (Notifications Push sur mobile)
FIREBASE_CREDENTIALS_PATH=core/firebase_credentials.json

# Déploiement (obligatoire avec core.settings.prod)
ALLOWED_HOSTS=naatal-agro.sn,api.naatal-agro.sn
CORS_ALLOWED_ORIGINS=https://naatal-agro.sn
# Modèle Gemini (modifiable sans toucher au code)
GEMINI_MODEL=gemini-2.5-flash

# Inscription : exiger l acceptation de la politique de confidentialité (activer quand le mobile envoie privacy_accepted)
PRIVACY_CONSENT_REQUIRED=False

# OTP : mode demonstration (renvoie le code dans la reponse, sans SMS). JAMAIS en production.
OTP_DEMO_MODE=False

# Inscription : code OTP unique tant qu'aucune passerelle SMS n'est branchee (vide = code aleatoire).
# Ne s'applique jamais a la reinitialisation de mot de passe. L'inscription ne bloque jamais sur le code
# tant que OTP_REQUIRED_FOR_REGISTER reste a False.
OTP_REGISTER_FIXED_CODE=1234
OTP_REQUIRED_FOR_REGISTER=False

# Plusieurs clés Gemini (rotation automatique quand l'une atteint son quota), séparées par des virgules
GEMINI_API_KEYS=
# Orchestration de l'IA : valeurs par défaut sûres. Le budget total doit rester SOUS le timeout gunicorn/nginx (60 s).
# AI_PROVIDER_ORDER=groq,gemini
# AI_TOTAL_BUDGET_SECONDS=40
# AI_DAILY_CALLS_PER_USER=150
